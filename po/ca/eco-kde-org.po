msgstr ""
"*Über Netzwerk empfangen*: Recepció de xarxa (és a dir, ‘X.NET.RxKBTot’)"

# skip-rule: t-acc_tan
#: content/be4foss-handbook/handbook_web.md:764
msgid "*Von Festplatte gelesen*: Disk read (i.e., ‘X.DSK.ReadKBTot’)"
msgstr ""
"*Von Festplatte gelesen*: Lectura de disc (és a dir, ‘X.DSK.ReadKBTot’)"

# skip-rule: t-acc_tan
#: content/be4foss-handbook/handbook_web.md:765
msgid "*Auf Festplatte geschrieben*: Disk written (i.e., ‘X.DSK.WriteKBTot’)"
msgstr ""
"*Auf Festplatte geschrieben*: Escriptura de disc (és a dir, ‘X.DSK."
"WriteKBTot’)"

# skip-rule: t-acc_tan
