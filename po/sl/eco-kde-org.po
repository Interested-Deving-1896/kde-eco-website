msgstr "43.00000"

#: content/be4foss-handbook/handbook_web.md:616
msgid "27.08.22, 16:52:04 ;"
msgstr "27.08.22, 16:52:04 ;"

#: content/be4foss-handbook/handbook_web.md:616
